<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no, viewport-fit=cover">
  <meta name="theme-color" content="#000000">
  <title>Dock Mode - ANPlayer</title>
  <link rel="stylesheet" href="/css/style.css">
  <link rel="stylesheet" href="/css/dock.css">
  <link rel="stylesheet" href="/css/visualizer.css">
</head>
<body class="dock-body">
  <div class="dock-container" id="dockContainer">
    <div class="dock-background" id="dockBackground"></div>
    <div class="dock-visualizer" id="dockVisualizer">
      <canvas id="dockVisualizerCanvas"></canvas>
    </div>

    <div class="dock-content">
      <div class="dock-top-bar" id="dockTopBar">
        <div class="dock-time" id="dockTime">00:00</div>
        <div class="dock-date" id="dockDate">Loading...</div>
        <div class="dock-top-actions">
          <button class="dock-btn" onclick="toggleAmbient()" title="Ambient Mode">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="5"/><line x1="12" y1="1" x2="12" y2="3"/><line x1="12" y1="21" x2="12" y2="23"/><line x1="4.22" y1="4.22" x2="5.64" y2="5.64"/><line x1="18.36" y1="18.36" x2="19.78" y2="19.78"/><line x1="1" y1="12" x2="3" y2="12"/><line x1="21" y1="12" x2="23" y2="12"/><line x1="4.22" y1="19.78" x2="5.64" y2="18.36"/><line x1="18.36" y1="5.64" x2="19.78" y2="4.22"/></svg>
          </button>
          <button class="dock-btn" onclick="toggleFullscreen()" title="Fullscreen">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M8 3H5a2 2 0 0 0-2 2v3m18 0V5a2 2 0 0 0-2-2h-3m0 18h3a2 2 0 0 0 2-2v-3M3 16v3a2 2 0 0 0 2 2h3"/></svg>
          </button>
        </div>
      </div>

      <div class="dock-main">
        <div class="dock-artwork-section">
          <div class="dock-artwork" id="dockArtwork">
            <div class="dock-artwork-placeholder">
              <svg width="80" height="80" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1"><circle cx="12" cy="12" r="10"/><polygon points="10 8 16 12 10 16 10 8"/></svg>
            </div>
          </div>
        </div>

        <div class="dock-queue-section" id="dockQueueSection">
          <div class="dock-queue-header">
            <span>Up Next</span>
            <span id="dockQueueCount">0</span>
          </div>
          <div class="dock-queue-list" id="dockQueueList">
            <div class="dock-queue-empty">Queue is empty</div>
          </div>
        </div>
      </div>

      <div class="dock-info-section">
        <div class="dock-song-info">
          <div class="dock-title" id="dockTitle">Not Playing</div>
          <div class="dock-artist" id="dockArtist">No tracks</div>
        </div>
      </div>

      <div class="dock-controls">
        <div class="dock-progress">
          <div class="dock-progress-bar" id="dockProgressBar">
            <div class="dock-progress-fill" id="dockProgressFill"></div>
          </div>
          <div class="dock-time-labels">
            <span id="dockCurrentTime">0:00</span>
            <span id="dockTotalTime">0:00</span>
          </div>
        </div>

        <div class="dock-buttons">
          <button class="dock-ctrl-btn" onclick="prevTrack()" aria-label="Previous">
            <svg width="28" height="28" viewBox="0 0 24 24" fill="currentColor"><path d="M6 6h2v12H6zm3.5 6l8.5 6V6z"/></svg>
          </button>
          <button class="dock-play-btn" id="dockPlayBtn" onclick="togglePlay()" aria-label="Play/Pause">
            <svg width="48" height="48" viewBox="0 0 24 24" fill="currentColor" id="dockPlayIcon"><polygon points="5 3 19 12 5 21 5 3"/></svg>
          </button>
          <button class="dock-ctrl-btn" onclick="nextTrack()" aria-label="Next">
            <svg width="28" height="28" viewBox="0 0 24 24" fill="currentColor"><path d="M18 6h2v12h-2zm-3.5 6l-8.5 6V6z"/></svg>
          </button>
        </div>

        <div class="dock-volume">
          <button class="dock-ctrl-btn" onclick="toggleMute()" aria-label="Volume">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" id="dockVolIcon"><polygon points="11 5 6 9 2 9 2 15 6 15 11 19 11 5"/><path d="M19.07 4.93a10 10 0 0 1 0 14.14M15.54 8.46a5 5 0 0 1 0 7.07"/></svg>
          </button>
          <input type="range" class="dock-volume-slider" id="dockVolumeSlider" min="0" max="100" value="80" oninput="setVolume(this.value)">
        </div>
      </div>
    </div>

    <div class="dock-ambient-toggle" id="dockAmbientToggle">
      <button onclick="window.location.href='/ambient'" title="Ambient Mode">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="5"/><line x1="12" y1="1" x2="12" y2="3"/><line x1="12" y1="21" x2="12" y2="23"/><line x1="4.22" y1="4.22" x2="5.64" y2="5.64"/><line x1="18.36" y1="18.36" x2="19.78" y2="19.78"/><line x1="1" y1="12" x2="3" y2="12"/><line x1="21" y1="12" x2="23" y2="12"/><line x1="4.22" y1="19.78" x2="5.64" y2="18.36"/><line x1="18.36" y1="5.64" x2="19.78" y2="4.22"/></svg>
      </button>
    </div>

    <div class="dock-nav" id="dockNav">
      <a href="/" class="dock-nav-btn">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>
      </a>
      <a href="/search" class="dock-nav-btn">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
      </a>
      <a href="/queue" class="dock-nav-btn">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="8" y1="6" x2="21" y2="6"/><line x1="8" y1="12" x2="21" y2="12"/><line x1="8" y1="18" x2="21" y2="18"/><line x1="3" y1="6" x2="3.01" y2="6"/><line x1="3" y1="12" x2="3.01" y2="12"/><line x1="3" y1="18" x2="3.01" y2="18"/></svg>
      </a>
      <a href="/settings" class="dock-nav-btn">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06A1.65 1.65 0 0 0 4.68 15a1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06A1.65 1.65 0 0 0 9 4.68a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06A1.65 1.65 0 0 0 19.4 9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z"/></svg>
      </a>
    </div>
  </div>

  <script src="/js/app.js"></script>
  <script src="/js/dock.js"></script>
  <script src="/js/visualizer.js"></script>
</body>
</html>

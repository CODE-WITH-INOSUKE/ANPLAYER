<%- include('partials/header') %>
<div class="page search-page">
  <div class="search-header">
    <div class="search-bar">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="search-icon"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
      <input type="text" id="searchInput" class="search-input" placeholder="Search songs, albums, artists..." value="<%= query %>" autofocus>
      <button class="search-clear" id="searchClear" style="display:none">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
      </button>
    </div>
    <div class="search-filters">
      <button class="filter-btn active" data-type="all">All</button>
      <button class="filter-btn" data-type="song">Songs</button>
      <button class="filter-btn" data-type="album">Albums</button>
      <button class="filter-btn" data-type="artist">Artists</button>
      <button class="filter-btn" data-type="playlist">Playlists</button>
    </div>
  </div>

  <div class="search-content" id="searchContent">
    <div class="search-initial" id="searchInitial">
      <% if (recentSearches.length > 0) { %>
      <section class="section">
        <div class="section-header">
          <h2>Recent Searches</h2>
          <button class="see-all danger" onclick="clearSearchHistory()">Clear</button>
        </div>
        <div class="recent-searches">
          <% recentSearches.forEach(function(s) { %>
          <div class="recent-search-item" onclick="document.getElementById('searchInput').value='<%= s.query.replace(/'/g, "\\'") %>'; doSearch()">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
            <span><%= s.query %></span>
          </div>
          <% }) %>
        </div>
      </section>
      <% } %>
    </div>

    <div class="search-results" id="searchResults" style="display:none">
      <div class="search-tabs">
        <div class="search-tab active" data-tab="songs">Songs <span class="tab-count" id="songCount">0</span></div>
        <div class="search-tab" data-tab="albums">Albums <span class="tab-count" id="albumCount">0</span></div>
        <div class="search-tab" data-tab="artists">Artists <span class="tab-count" id="artistCount">0</span></div>
        <div class="search-tab" data-tab="playlists">Playlists <span class="tab-count" id="playlistCount">0</span></div>
      </div>
      <div class="search-tab-content" id="songsTab">
        <div class="song-list" id="songResults"></div>
      </div>
      <div class="search-tab-content" id="albumsTab" style="display:none">
        <div class="card-row" id="albumResults"></div>
      </div>
      <div class="search-tab-content" id="artistsTab" style="display:none">
        <div class="card-row" id="artistResults"></div>
      </div>
      <div class="search-tab-content" id="playlistsTab" style="display:none">
        <div class="card-row" id="playlistResults"></div>
      </div>
    </div>
  </div>
</div>

<script src="/js/search.js"></script>
<%- include('partials/footer') %>

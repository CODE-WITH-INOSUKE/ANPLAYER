<div class="page playlist-page">
  <div class="page-header">
    <div class="playlist-info">
      <h1><%= playlist.name %></h1>
      <p><%= playlist.song_count %> tracks</p>
      <% if (playlist.description) { %><p class="playlist-desc"><%= playlist.description %></p><% } %>
    </div>
    <div class="page-actions">
      <form method="POST" action="/playlists/<%= playlist.id %>/rename" style="display:inline" class="rename-form">
        <input type="text" name="name" value="<%= playlist.name %>" required class="rename-input" onblur="this.form.submit()">
      </form>
      <form method="POST" action="/playlists/<%= playlist.id %>/delete" style="display:inline" onsubmit="return confirm('Delete this playlist?')">
        <button type="submit" class="btn btn-danger">Delete</button>
      </form>
    </div>
  </div>

  <% if (songs.length > 0) { %>
  <div class="song-list" id="playlistSongList">
    <% songs.forEach(function(song, idx) { %>
    <div class="song-item" data-entry-id="<%= song.entry_id %>" onclick="loadSong({id: <%= song.id %>, title: '<%= song.title.replace(/'/g, "\\'") %>', artist: '<%= song.artist.replace(/'/g, "\\'") %>', album: '<%= (song.album || '').replace(/'/g, "\\'") %>', duration: <%= song.duration %>, artwork: '<%= song.artwork || '' %>', youtube_id: '<%= song.youtube_id %>'})">
      <div class="song-pos"><%= idx + 1 %></div>
      <div class="song-artwork">
        <% if (song.artwork) { %>
        <img src="<%= song.artwork %>" alt="" loading="lazy">
        <% } else { %>
        <div class="song-artwork-placeholder">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="12" cy="12" r="10"/><polygon points="10 8 16 12 10 16 10 8"/></svg>
        </div>
        <% } %>
      </div>
      <div class="song-info">
        <div class="song-title"><%= song.title %></div>
        <div class="song-artist"><%= song.artist %></div>
      </div>
      <div class="song-duration"><%= formatDuration(song.duration) %></div>
      <div class="song-actions">
        <form method="POST" action="/playlists/<%= playlist.id %>/remove/<%= song.entry_id %>" style="display:inline">
          <button type="submit" class="song-action-btn" onclick="event.stopPropagation()">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="15" y1="9" x2="9" y2="15"/><line x1="9" y1="9" x2="15" y2="15"/></svg>
          </button>
        </form>
      </div>
    </div>
    <% }) %>
  </div>
  <% } else { %>
  <div class="empty-state">
    <p>This playlist is empty. Search for songs and add them.</p>
  </div>
  <% } %>
</div>

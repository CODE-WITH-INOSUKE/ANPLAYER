<%- include('partials/header') %>
<div class="page artist-page">
  <div class="artist-header">
    <div class="artist-artwork">
      <% if (artist.artwork) { %>
      <img src="<%= artist.artwork %>" alt="">
      <% } else { %>
      <div class="artist-artwork-placeholder">
        <svg width="64" height="64" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
      </div>
      <% } %>
    </div>
    <div class="artist-info">
      <h1><%= artist.name %></h1>
      <p><%= artist.song_count %> songs • <%= artist.album_count %> albums</p>
    </div>
  </div>

  <% if (albums.length > 0) { %>
  <section class="section">
    <h2>Albums</h2>
    <div class="card-row">
      <% albums.forEach(function(album) { %>
      <div class="card" onclick="window.location.href='/library/albums/<%= album.id %>'">
        <div class="card-artwork">
          <% if (album.artwork) { %>
          <img src="<%= album.artwork %>" alt="" loading="lazy">
          <% } else { %>
          <div class="card-artwork-placeholder">
            <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="12" cy="12" r="10"/><circle cx="12" cy="12" r="3"/></svg>
          </div>
          <% } %>
        </div>
        <div class="card-info">
          <div class="card-title"><%= album.title %></div>
          <div class="card-subtitle"><%= album.year %></div>
        </div>
      </div>
      <% }) %>
    </div>
  </section>
  <% } %>

  <section class="section">
    <h2>Songs</h2>
    <% if (songs.length > 0) { %>
    <div class="song-list">
      <% songs.forEach(function(song) { %>
      <div class="song-item" onclick="loadSong({id: <%= song.id %>, title: '<%= song.title.replace(/'/g, "\\'") %>', artist: '<%= song.artist.replace(/'/g, "\\'") %>', album: '<%= (song.album || '').replace(/'/g, "\\'") %>', duration: <%= song.duration %>, artwork: '<%= song.artwork || '' %>', youtube_id: '<%= song.youtube_id %>'})">
        <div class="song-artwork">
          <% if (song.artwork) { %>
          <img src="<%= song.artwork %>" alt="" loading="lazy">
          <% } else { %>
          <div class="song-artwork-placeholder">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="12" cy="12" r="10"/><polygon points="10 8 16 12 10 16 10 8"/></svg>
          </div>
          <% } %>
        </div>
        <div class="song-info">
          <div class="song-title"><%= song.title %></div>
          <div class="song-artist"><%= song.album %></div>
        </div>
        <div class="song-duration"><%= formatDuration(song.duration) %></div>
        <div class="song-actions">
          <button class="song-action-btn" onclick="event.stopPropagation(); addToQueue(<%= song.id %>)">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
          </button>
        </div>
      </div>
      <% }) %>
    </div>
    <% } else { %>
    <div class="empty-state"><p>No songs found for this artist.</p></div>
    <% } %>
  </section>
</div>
<%- include('partials/footer') %>
